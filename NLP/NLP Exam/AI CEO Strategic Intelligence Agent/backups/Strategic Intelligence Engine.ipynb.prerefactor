     ]
    }
   ],
   "source": [
    "sentiment_pipe = pipeline(\"sentiment-analysis\",\n",
    "                          model=\"cardiffnlp/twitter-roberta-base-sentiment-latest\")\n",
    "\n",
    "#3-class sentiment (negative / neutral / positive)\n",
    "from collections import Counter\n",
    "\n",
    "counts = Counter()\n",
    "for d in documents:\n",
    "    label = sentiment_pipe(d[\"text\"][:512])[0][\"label\"]\n",
    "    d[\"sentiment\"] = label          # store it on the doc (reuse later — no re-running)\n",
    "    counts[label] += 1\n",
    "\n",
    "print(counts)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e9331cfc",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Done classifying\n",
      "Counter({'trend': 98, 'risk': 75, 'opportunity': 12})\n"
     ]
    }
   ],
   "source": [
    "labels = [\"opportunity\", \"risk\", \"trend\"]\n",
    "sev_labels = [\"high severity\", \"medium severity\", \"low severity\"]\n",
    "\n",
    "for d in documents:\n",
    "    result = classifier(d[\"text\"], candidate_labels=labels)   # call once\n",
    "    d[\"category\"]       = result[\"labels\"][0]                 # top label\n",
    "    d[\"category_score\"] = round(float(result[\"scores\"][0]), 3)  # confidence\n",
    "    if d[\"category\"] == \"risk\":                                 # severity only for risks\n",
    "        d[\"severity\"] = classifier(d[\"text\"], candidate_labels=sev_labels)[\"labels\"][0].split()[0].capitalize()\n",
    "\n",
    "print(\"Done classifying\")\n",
    "from collections import Counter\n",
    "print(Counter(d[\"category\"] for d in documents))\n",
    "print(Counter(d[\"severity\"] for d in documents))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "29e75805",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Saved 185 labeled docs\n"
     ]
    }
   ],
   "source": [
    "import json\n",
    "json.dump(documents,\n",
    "          open(\"lufthansa_labeled.json\", \"w\", encoding=\"utf-8\"),\n",
    "          ensure_ascii=False, indent=2)\n",
    "print(\"Saved\", len(documents), \"labeled docs\")"
   ]
  }
 ],
