      "{'sequence': 'Lufthansa faces pilot strikes and rising fuel costs threatening its profits.', 'labels': ['risk', 'trend', 'opportunity'], 'scores': [0.9322348237037659, 0.05446822941303253, 0.013296927325427532]}\n"
     ]
    }
   ],
   "source": [
    "from transformers import pipeline\n",
    "\n",
    "# load the zero-shot classifier (first run downloads the model — may take a minute)\n",
    "classifier = pipeline(\"zero-shot-classification\", model=\"facebook/bart-large-mnli\")\n",
    "\n",
    "labels = [\"opportunity\", \"risk\", \"trend\"]\n",
    "\n",
    "text = \"Lufthansa faces pilot strikes and rising fuel costs threatening its profits.\"\n",
    "result = classifier(text, candidate_labels=labels)\n",
    "\n",
    "print(result)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "73e5f714",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[trend] (0.39)  Financial reports - Lufthansa Group Investor Relations. Financial reports 1st Interim Repo\n",
      "\n",
      "[trend] (0.43)  Financial reports & publications - Lufthansa Group Investor Relations. The Lufthansa Group\n",
      "\n",
      "[trend] (0.41)  Lufthansa - Annual Reports - CompaniesMarketCap.com. Annual Reports Annual Reports Half-ye\n",
      "\n",
      "[risk] (0.38)  Financial Data - Lufthansa Technik. Three-quarters of revenue now comes from business with\n",
      "\n",
      "[trend] (0.46)  Lufthansa Group reports successful financial year 2025. Mar 6, 2026 · Deutsche Lufthansa A\n",
      "\n"
     ]
    }
   ],
   "source": [
    "import json\n",
    "documents = json.load(open(\"lufthansa_data.json\", encoding=\"utf-8\"))\n",
    "\n",
    "labels = [\"opportunity\", \"risk\", \"trend\"]\n",
    "\n",
    "# test on the first 5 real docs\n",
    "for d in documents[:5]:\n",
    "    result = classifier(d[\"text\"], candidate_labels=labels)\n",
    "    cat   = result[\"labels\"][0]\n",
    "    score = result[\"scores\"][0]\n",
    "    print(f\"[{cat}] ({score:.2f})  {d['text'][:90]}\")\n",
    "    print()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "947b1428",
   "metadata": {},
   "outputs": [
    {
     "name": "stderr",
     "output_type": "stream",
     "text": [
      "Some weights of the model checkpoint at cardiffnlp/twitter-roberta-base-sentiment-latest were not used when initializing RobertaForSequenceClassification: ['roberta.pooler.dense.bias', 'roberta.pooler.dense.weight']\n",
      "- This IS expected if you are initializing RobertaForSequenceClassification from the checkpoint of a model trained on another task or with another architecture (e.g. initializing a BertForSequenceClassification model from a BertForPreTraining model).\n",
      "- This IS NOT expected if you are initializing RobertaForSequenceClassification from the checkpoint of a model that you expect to be exactly identical (initializing a BertForSequenceClassification model from a BertForSequenceClassification model).\n"
     ]
    },
    {
